function validateTournament_(ms){const rounds=new Set(),lost=new Map(),highest=new Map();for(const m of ms){for(const n of [m.left,m.right]){const k=m.round+'|'+n;if(rounds.has(k))throw Error('Spieler mehrfach in derselben Runde: '+n+'. Widersprüchlichen Scan korrigieren.');rounds.add(k);highest.set(n,Math.max(highest.get(n)||0,m.round));}const loser=m.leftScore<m.rightScore?m.left:m.right;if(lost.has(loser))throw Error('Spieler mit mehreren Niederlagen: '+loser);lost.set(loser,m.round);}for(const [n,r]of lost)if(highest.get(n)>r)throw Error('Rundenfolge widersprüchlich: '+n);}

function eventDate_(payload,year){const explicit=String(payload.eventDate||'').trim();let m=explicit.match(/^(\d{4})-(\d{2})-(\d{2})$/);if(explicit&&!m)throw Error('eventDate muss YYYY-MM-DD enthalten.');if(!m){const text=String(payload.title||'')+'\n'+String(payload.text||'');const hit=text.match(/\b(\d{1,2})\s+(January|February|March|April|May|June|July|August|September|October|November|December)\s+(20\d{2})\b/i);if(hit){const months=['january','february','march','april','may','june','july','august','september','october','november','december'];m=[hit[0],hit[3],String(months.indexOf(hit[2].toLowerCase())+1).padStart(2,'0'),hit[1].padStart(2,'0')];}else{const hit=text.match(/\b(\d{1,2})\.(\d{1,2})\.(20\d{2})\b/);if(hit)m=[hit[0],hit[3],hit[2].padStart(2,'0'),hit[1].padStart(2,'0')];}}if(!m)return null;const y=Number(m[1]),mo=Number(m[2]),d=Number(m[3]),date=new Date(Date.UTC(y,mo-1,d));if(y!==year||date.getUTCFullYear()!==y||date.getUTCMonth()!==mo-1||date.getUTCDate()!==d)throw Error('Turnierdatum ist ungültig oder passt nicht zum Jahr.');return [m[1],m[2],m[3]].join('-');}


