const DS={first:11,rowHeight:70,maxEvents:200,playerHeader:['Key','Event','Spieler','Flagge','Land','Deutsch?','Status','Beste Runde','Rundenwert','Quelle','Letzter Sync','Besiegt von','Avg Max','Whitewash +','Whitewash -','Hinweis'],matchHeader:['Key','Event','Runde','Links','Rechts','Legs links','Legs rechts','Avg links','Avg rechts','Walkover']};
function ss_(){const p=PropertiesService.getScriptProperties(),id=p.getProperty('SPREADSHEET_ID');if(id)return SpreadsheetApp.openById(id);const s=SpreadsheetApp.getActiveSpreadsheet();if(!s)throw Error('Cloud-Verbindung zuerst im Tabellenmenü vorbereiten.');p.setProperty('SPREADSHEET_ID',s.getId());return s;}
function onOpen(){applyWorkbookView_();SpreadsheetApp.getUi().createMenu('DartSync').addItem('Neues Jahr anlegen','createYearSheetPrompt').addItem('Ansicht aufräumen (70 Pixel)','tidyWorkbookView').addItem('Bestehendes Jahr übernehmen','adoptYearPrompt').addItem('Dropdowns aktualisieren','setDropdowns').addItem('Jokerformeln aktualisieren','refreshYearFormulas').addItem('Alle Jahresformeln reparieren','repairAllYearFormulas').addSeparator().addItem('Saisonübersichten aktualisieren','setupSeasonExtras').addItem('Tipp-Lock & automatische Übersicht aktivieren','enableTipLocks').addItem('Tipp-Lock & Übersicht-Automatik stoppen','disableTipLocks').addSeparator().addItem('Cloud-Verbindung vorbereiten','prepareCloud').addItem('Cloud-Abruf pausieren','pauseCloud').addItem('Cloud-Abruf fortsetzen','resumeCloud').addToUi();}
function askNumber_(title,text,min,max){const ui=SpreadsheetApp.getUi(),a=ui.prompt(title,text,ui.ButtonSet.OK_CANCEL);if(a.getSelectedButton()!==ui.Button.OK)return null;const n=Number(a.getResponseText());if(!Number.isInteger(n)||n<min||n>max)throw Error('Bitte eine ganze Zahl zwischen '+min+' und '+max+' eingeben.');return n;}
function createYearSheetPrompt(){const y=askNumber_('Neues Jahr','Jahr, zum Beispiel 2027',2020,2100);if(y===null)return;const n=askNumber_('Turniere','Anzahl der Turniere (1–200)',1,DS.maxEvents);if(n===null)return;createYear_(y,n);SpreadsheetApp.getUi().alert('Jahr '+y+' mit '+n+' Turnieren angelegt.');}
function config_(y){const raw=PropertiesService.getDocumentProperties().getProperty('year:'+y);if(!raw)throw Error('Jahr '+y+' zuerst anlegen oder übernehmen.');return JSON.parse(raw);}
function sheet_(name,header){let s=ss_().getSheetByName(name);if(!s){s=ss_().insertSheet(name);s.getRange(1,1,1,header.length).setValues([header]);s.setFrozenRows(1);}if(isHelperSheet_(name)&&!s.isSheetHidden())s.hideSheet();return s;}
function rows_(s,n){return s.getLastRow()>1?s.getRange(2,1,s.getLastRow()-1,n).getValues():[];}
function writeRows_(s,header,rows){const old=s.getLastRow();s.getRange(1,1,rows.length+1,header.length).setValues([header].concat(rows));if(old>rows.length+1)s.getRange(rows.length+2,1,old-rows.length-1,header.length).clearContent();}
function createYear_(y,n){if(ss_().getSheetByName(String(y)))throw Error('Jahr existiert bereits.');const template=ss_().getSheetByName('Jahresvorlage');if(!template)throw Error('Jahresvorlage fehlt.');const s=template.copyTo(ss_()).setName(String(y)).showSheet();if(s.getMaxRows()<DS.first+n-1)s.insertRowsAfter(s.getMaxRows(),DS.first+n-1-s.getMaxRows());
// copyTo erhält alle Spaltenbreiten; ausdrücklich keine automatische Größenanpassung.
for(let c=1;c<=template.getMaxColumns();c++)s.setColumnWidth(c,template.getColumnWidth(c));
s.getRange(DS.first,1,s.getMaxRows()-DS.first+1,41).clearContent().clearDataValidations();for(let i=0;i<n;i++){template.getRange(11,1,1,41).copyTo(s.getRange(DS.first+i,1,1,41),SpreadsheetApp.CopyPasteType.PASTE_FORMAT,false);s.getRange(DS.first+i,1).setValue(i+1);s.getRange(DS.first+i,5).setValue('Nein');s.getRange(DS.first+i,8).setValue('Nein');}
PropertiesService.getDocumentProperties().setProperty('year:'+y,JSON.stringify({first:DS.first,count:n}));sheet_('Spieler_'+y,DS.playerHeader);sheet_('Matches_'+y,DS.matchHeader);installFormulas_(s,y,DS.first,n);setDropdowns();refreshSeason_(y);}
function adoptYearPrompt(){const y=askNumber_('Bestehendes Jahr übernehmen','Jahr der vorhandenen Daten, zum Beispiel 2026',2020,2100);if(y===null)return;const s=ss_().getSheetByName(String(y));if(!s)throw Error('Jahresblatt fehlt.');if(PropertiesService.getDocumentProperties().getProperty('year:'+y))throw Error('Jahr bereits eingerichtet.');const vals=s.getRange(1,1,s.getLastRow(),1).getValues();const events=vals.map((r,i)=>({n:r[0],r:i+1})).filter(x=>typeof x.n==='number'&&x.n>=1&&x.n<=DS.maxEvents);if(!events.length)throw Error('Keine Turnierzeilen gefunden.');const first=events[0].r,last=events[events.length-1].r;if(events.length!==last-first+1)throw Error('Turnierzeilen müssen zusammenhängend sein.');const source=ss_().getSheetByName('Spieler');if(!source)throw Error('Alter Spieler-Tab fehlt.');const target=sheet_('Spieler_'+y,DS.playerHeader);if(target.getLastRow()>1)throw Error('Jahresspielerdaten existieren bereits.');const copy=rows_(source,16).filter(r=>r[2]).map(r=>{r[0]=y+'|'+r[1]+'|'+r[2];return r;});writeRows_(target,DS.playerHeader,copy);sheet_('Matches_'+y,DS.matchHeader);PropertiesService.getDocumentProperties().setProperty('year:'+y,JSON.stringify({first,count:events.length}));installFormulas_(s,y,first,events.length);setDropdowns();refreshSeason_(y);SpreadsheetApp.getUi().alert('Daten übernommen. Originaltab Spieler bleibt als Sicherung erhalten. Für bereits gespielte Turniere wird der erste neue Matchimport erst bei vollständiger Erfassung übernommen.');}
function installFormulas_(s,y,first,n){s.getRange(first,2,n,1).setNumberFormat('dd.mm.yyyy').setDataValidation(SpreadsheetApp.newDataValidation().requireDate().setAllowInvalid(false).build());s.getRange('A1').setValue('Gesamtstand '+y);const end=first+n-1;writeFormula_(s.getRange('B2'),'=SUM(AL'+first+':AL'+end+')');writeFormula_(s.getRange('B3'),'=SUM(AO'+first+':AO'+end+')');writeFormula_(s.getRange('E2'),'=IF(B2>B3,"Julian",IF(B3>B2,"Nico","Unentschieden"))');writeFormula_(s.getRange('E3'),'=ABS(B2-B3)');writeFormula_(s.getRange('B4'),'="Julian: "&COUNTIF(E'+first+':E'+end+',"Ja")&" / Nico: "&COUNTIF(H'+first+':H'+end+',"Ja")');writeFormulas_(s.getRange(first,13,n,29),Array.from({length:n},(_,i)=>formulas_(y,first+i)));s.getRange(first,32,n,1).setWrap(true);s.getRange(first,34,n,1).setWrap(true);s.setRowHeightsForced(first,n,DS.rowHeight);}
function formulas_(y,r){const fs=FORMULAS.map(f=>f.replace(/(\$?[A-Z]+\$?)10\b/g,'$1'+r).replaceAll('Spieler!',"'Spieler_"+y+"'!").replaceAll('$A'+r+'&"|"&','"'+y+'|"&$A'+r+'&"|"&'));
for(const j of [true,false]){const idx=j?19:21,total=j?23:26,p=j?'O':'Q',d=j?'P':'R',toggle=j?'E':'H',pickP=j?'C':'F',pickD=j?'D':'G',colleague=j?'Nico':'Julian';let base=fs[idx];const split=base.indexOf(',IF(AND(okP,okD)');if(split<0)throw Error('Joker-Vorlage ungültig');base=base.slice(base.indexOf('LET(')+4,split);
const lookup=n=>'IFERROR(VLOOKUP("'+y+'|"&$A'+r+'&"|"&'+n+",'Spieler_"+y+"'!$A:$P,9,FALSE),0)";
base+=',nextP,'+lookup('oppP')+',nextD,'+lookup('oppD');
// Primär erreichte Runde; bei gleicher Runde Ersatzpunkte; danach normales Pferd.
const preferD='OR(nextD>nextP,AND(nextD=nextP,ptsD>ptsP))',chooseD='AND(okD,OR(NOT(okP),'+preferD+'))';
const replacement='IF('+chooseD+',oppD&CHAR(10)&"übernimmt "&'+pickD+r+',oppP&CHAR(10)&"übernimmt "&'+pickP+r+')';
const warning='IF(blockP,CHAR(10)&'+pickP+r+'&": Übernahme von "&oppP&" gesperrt – Pferd von '+colleague+'","")&IF(blockD,CHAR(10)&'+pickD+r+'&": Übernahme von "&oppD&" gesperrt – Pferd von '+colleague+'","")';
fs[idx]='=IF('+toggle+r+'<>"Ja","—",LET('+base+',IF(OR(okP,okD),'+replacement+',"Keine gültige Übernahme")&'+warning+'))';
fs[idx+1]='=IF('+toggle+r+'<>"Ja","",LET('+base+',IF(OR(okP,okD),IF('+chooseD+',ptsD,ptsP),0)))';
fs[total]='=IF('+toggle+r+'<>"Ja",'+p+r+'+'+d+r+',LET('+base+',IF(OR(okP,okD),IF('+chooseD+',ptsD+'+p+r+',ptsP+'+d+r+'),'+p+r+'+'+d+r+')))';
}return fs;}
function refreshYearFormulas(){for(const s of ss_().getSheets())if(/^20\d{2}$/.test(s.getName())){const y=Number(s.getName());let c;try{c=config_(y);}catch(e){continue;}installFormulas_(s,y,c.first,c.count);}SpreadsheetApp.getUi().alert('Formeln aller eingerichteten Jahre aktualisiert.');}
function setDropdowns(){for(const s of ss_().getSheets()){if(!/^20\d{2}$/.test(s.getName()))continue;const y=Number(s.getName());let c;try{c=config_(y);}catch(e){continue;}const players=rows_(sheet_('Spieler_'+y,DS.playerHeader),16);const yes=SpreadsheetApp.newDataValidation().requireValueInList(['Nein','Ja'],true).setAllowInvalid(false).build();for(let i=0;i<c.count;i++){const row=c.first+i,event=Number(s.getRange(row,1).getValue());for(const col of [5,8])s.getRange(row,col).setDataValidation(yes);for(const col of [3,4,6,7]){const names=[...new Set(players.filter(p=>Number(p[1])===event&&(![4,7].includes(col)||p[5]==='Ja')&&!/^(withdrawn|declined|not confirmed)$/i.test(p[6])).map(p=>p[2]))].sort();const cell=s.getRange(row,col);if(names.length)cell.setDataValidation(SpreadsheetApp.newDataValidation().requireValueInList(names,true).setAllowInvalid(false).build());else cell.clearDataValidations();}}}}
function name_(s){s=String(s||'').replace(/\s+/g,' ').trim();if(s.includes(',')){const a=s.split(',');s=a.slice(1).join(',').trim()+' '+a[0].trim();}return s;}
function norm_(s){return name_(s).normalize('NFD').replace(/[\u0300-\u036f]/g,'').toLowerCase().replace(/[^a-z0-9]/g,'');}
function round_(s){const map={'finals':7,'final':7,'semi-finals':6,'semi finals':6,'quarter-finals':5,'quarter finals':5,'top 16':4,'top 32':3,'top 64':2,'top 128':1,'last 16':4,'last 32':3,'last 64':2,'last 128':1};return map[String(s).toLowerCase()]||0;}
function roundName_(n){return ['','Letzte 128','Letzte 64','Letzte 32','Letzte 16','Viertelfinale','Halbfinale','Finale','Sieger'][n]||'';}
function parseTextMatches_(text,lookup){const lines=String(text).replace(/\t/g,'\n').split(/\r?\n/).map(s=>s.replace(/[–—]/g,'-').trim()).filter(Boolean),out=[];let round=0;
for(let i=0;i<lines.length;i++){if(/^---.*---$/.test(lines[i])){round=0;continue;}if(round_(lines[i])){round=round_(lines[i]);continue;}if(!/^B\d+$/i.test(lines[i])||!round)continue;const b=[];for(let k=i+1;k<lines.length;k++){if(/^B\d+$/i.test(lines[k])||round_(lines[k])||/^---.*---$/.test(lines[k]))break;const m=lines[k].match(/^(\d+)\s*-\s*(\d+)$/);b.push(...(m?[m[1],'-',m[2]]:[lines[k]]));}
for(let k=1;k<b.length-1;k++)if(b[k]==='-'&&/^\d+$/.test(b[k-1])&&/^\d+$/.test(b[k+1])){const a=b[k-2],z=b[k+2];if(!a||!z)continue;const valid=n=>lookup.has(norm_(n))||/^[\p{L}'’ .-]+,\s*[\p{L}'’ .-]+$/u.test(n);if(!valid(a)||!valid(z))continue;const avg=v=>/^\d{1,3}[.,]\d{1,2}$/.test(v||'')?Number(v.replace(',','.')):'';out.push({round,left:lookup.get(norm_(a))||name_(a),right:lookup.get(norm_(z))||name_(z),leftScore:Number(b[k-1]),rightScore:Number(b[k+1]),leftAvg:avg(b[k-3]),rightAvg:avg(b[k+3])});break;}}
return out;}
function validateMatch_(m){if(m.walkover===true){if(!Number.isInteger(m.round)||m.round<1||m.round>7||!m.left||!m.right||norm_(m.left)===norm_(m.right)||!((m.leftScore===1&&m.rightScore===0)||(m.leftScore===0&&m.rightScore===1)))throw Error('Ungültiger Walkover');return;}const target=m.round===7?8:m.round===6?7:6;if(!Number.isInteger(m.round)||m.round<1||m.round>7||!m.left||!m.right||norm_(m.left)===norm_(m.right)||![m.leftScore,m.rightScore].every(Number.isInteger)||Math.max(m.leftScore,m.rightScore)!==target||Math.min(m.leftScore,m.rightScore)<0||m.leftScore===m.rightScore)throw Error('Ungültiges/noch laufendes Spiel. Nur abgeschlossene Spiele senden.');for(const a of [m.leftAvg,m.rightAvg])if(a!==''&&a!==undefined&&a!==null&&(!Number.isFinite(Number(a))||Number(a)<0||Number(a)>180))throw Error('Ungültiger Average.');}
function matchKey_(e,m){return JSON.stringify([e,m.round,...[m.left,m.right].sort()]);}
function playerRow_(y,e,p){if(!p.name)throw Error('Spielername fehlt');return [y+'|'+e+'|'+name_(p.name),e,name_(p.name),p.flag||'',p.country||'',p.isGerman?'Ja':'Nein',p.status||'confirmed','',0,'entries',new Date(),'','',0,0,''];}
function rebuild_(y,e,old,matches){const map=new Map(old.map(r=>[r[2],r.slice()]));for(const r of map.values()){r[6]='confirmed';r[7]='';r[8]=0;r[11]='';r[12]='';r[13]=0;r[14]=0;}
function get(n){if(!map.has(n))map.set(n,playerRow_(y,e,{name:n}));return map.get(n);}
let winner='',finalist='';for(const m of matches){const won=m.leftScore>m.rightScore,wn=won?m.left:m.right,ln=won?m.right:m.left;for(const [n,rv,avg] of [[wn,m.round+1,won?m.leftAvg:m.rightAvg],[ln,m.round,won?m.rightAvg:m.leftAvg]]){const p=get(n);p[6]='played';p[8]=Math.max(p[8],rv);p[7]=roundName_(p[8]);p[9]='matches';p[10]=new Date();if(avg!==''&&avg!==undefined&&avg!==null)p[12]=Math.max(Number(p[12]||0),Number(avg));}get(ln)[11]=wn;if(!m.walkover&&Math.min(m.leftScore,m.rightScore)===0){get(wn)[13]++;get(ln)[14]++;}if(m.round===7){winner=wn;finalist=ln;}}
const ps=[...map.values()],g=ps.filter(r=>r[5]==='Ja'&&r[8]>0),best=Math.max(0,...g.map(r=>r[8]));return {players:ps,winner,finalist,bestGerman:g.filter(r=>r[8]===best).map(r=>r[2]).join(', ')};}
function complete_(ms){return new Set(ms.flatMap(m=>[m.left,m.right])).size===128&&[64,32,16,8,4,2,1].every((n,i)=>ms.filter(m=>m.round===i+1).length===n);}
function syncPayload_(payload){const url=String(payload.url||''),id=url.match(/pdcpc(\d{2})e(\d+)/i);const year=Number(payload.year||(id?2000+Number(id[1]):0)),event=Number(payload.eventNo||(id?id[2]:0));if(!Number.isInteger(year)||year<2020||!Number.isInteger(event)||event<1)throw Error('Jahr und Turniernummer fehlen.');if(id&&year!==2000+Number(id[1]))throw Error('Jahr passt nicht zur DartConnect-Adresse.');const eventDate=eventDate_(payload,year);const c=config_(year),s=ss_().getSheetByName(String(year)),ev=s.getRange(c.first,1,c.count,1).getValues().findIndex(r=>Number(r[0])===event);if(ev<0)throw Error('Turnier nicht im gewählten Jahresblatt.');const lock=LockService.getScriptLock();lock.waitLock(30000);try{const sp=sheet_('Spieler_'+year,DS.playerHeader),all=rows_(sp,16),old=all.filter(r=>Number(r[1])===event),other=all.filter(r=>Number(r[1])!==event),lookup=new Map(old.map(r=>[norm_(r[2]),r[2]]));let result;
if(payload.type==='calendar'){if(!eventDate)throw Error('Turnierdatum fehlt');s.getRange(c.first+ev,2).setValue(Utilities.parseDate(eventDate,ss_().getSpreadsheetTimeZone(),'yyyy-MM-dd')).setNumberFormat('dd.mm.yyyy');refreshSeason_(year);return {year,event,type:'calendar'};}if(payload.type==='nineDarters'){syncNineDarters_(payload,s,c.first+ev,year,event);SpreadsheetApp.flush();refreshSeason_(year);return {year,event,type:'nineDarters'};}if(payload.type==='entries'||/\/(entries|confirmation)/.test(url)){const incoming=payload.players||parseEntries_(payload.text);if(!incoming.length)throw Error('Keine Teilnehmer erkannt.');nineDarterNames_(payload,old.map(r=>r[2]).concat(incoming.map(p=>name_(p.name))));const merged=new Map(old.map(r=>[norm_(r[2]),r]));for(const p of incoming){const key=norm_(p.name),r=merged.get(key);if(r){if(p.country)r[4]=p.country;if(p.flag)r[3]=p.flag;if(typeof p.isGerman==='boolean')r[5]=p.isGerman?'Ja':'Nein';if(Number(r[8]||0)===0&&p.status)r[6]=p.status;}else merged.set(key,playerRow_(year,event,p));}writeRows_(sp,DS.playerHeader,other.concat([...merged.values()]));result={type:'entries',players:incoming.length};}
else {const incoming=payload.matches||parseTextMatches_(payload.text,lookup);if(!incoming.length)throw Error('Keine abgeschlossenen Spiele erkannt.');incoming.forEach(validateMatch_);nineDarterNames_(payload,old.map(r=>r[2]).concat(incoming.flatMap(m=>[name_(m.left),name_(m.right)])));const sh=sheet_('Matches_'+year,DS.matchHeader),allM=rows_(sh,10),map=new Map(allM.filter(r=>Number(r[1])===event).map(r=>[r[0],{round:r[2],left:r[3],right:r[4],leftScore:r[5],rightScore:r[6],leftAvg:r[7],rightAvg:r[8],walkover:r[9]===true}]));const batch=new Map();for(const raw of incoming){const m={...raw,left:lookup.get(norm_(raw.left))||name_(raw.left),right:lookup.get(norm_(raw.right))||name_(raw.right)};const key=matchKey_(event,m);const prev=batch.get(key);if(prev&&JSON.stringify([prev.left,prev.leftScore,prev.rightScore])!==JSON.stringify([m.left,m.leftScore,m.rightScore]))throw Error('Widersprüchliche Spiele im selben Scan.');batch.set(key,m);}for(const [k,m]of batch)map.set(k,m);const ms=[...map.values()];validateTournament_(ms);
// Historische Gesamtwerte können ohne historische Einzelspiele nicht sicher addiert werden.
if(!allM.some(r=>Number(r[1])===event)&&old.some(r=>Number(r[8])>0)&&!complete_(ms))throw Error('Übernommenes Turnier: zuerst alle 127 Spiele in einem Scan senden. Bestehende Punkte bleiben erhalten.');
result=rebuild_(year,event,old,ms);const rows=[...map].map(([k,m])=>[k,event,m.round,m.left,m.right,m.leftScore,m.rightScore,m.leftAvg??'',m.rightAvg??'',m.walkover===true]);writeRows_(sh,DS.matchHeader,allM.filter(r=>Number(r[1])!==event).concat(rows));writeRows_(sp,DS.playerHeader,other.concat(result.players));const row=c.first+ev;s.getRange(row,9,1,3).setValues([[result.winner,result.finalist,result.bestGerman]]);s.getRange(row,9).setNote(complete_(ms)?'127 Spiele vollständig erfasst.':'Vorläufig: '+ms.length+' Spiele erfasst. Fehlende Abschnitte erneut synchronisieren.');s.setRowHeightsForced(row,1,DS.rowHeight);result={type:'matches',matches:ms.length,complete:complete_(ms)};}
syncNineDarters_(payload,s,c.first+ev,year,event);if(eventDate)s.getRange(c.first+ev,2).setValue(Utilities.parseDate(eventDate,ss_().getSpreadsheetTimeZone(),'yyyy-MM-dd')).setNumberFormat('dd.mm.yyyy');setDropdowns();SpreadsheetApp.flush();refreshSeason_(year);return {year,event,...result};}finally{lock.releaseLock();}}
function doGet(){return ContentService.createTextOutput('DartSync 2 bereit.');}
function doPost(e){try{const p=JSON.parse(e.postData.contents);const token=PropertiesService.getScriptProperties().getProperty('SYNC_TOKEN');if(!token||p.token!==token)throw Error('Sync-Token fehlt oder ist falsch. Token in den Script-Eigenschaften setzen und im Bookmarklet mitsenden.');if(p.operation==='plan')return json_({ok:true,result:cloudPlan_()});return json_({ok:true,result:syncPayload_(p)});}catch(e){return json_({ok:false,error:String(e.message||e)});}}
function json_(v){return ContentService.createTextOutput(JSON.stringify(v)).setMimeType(ContentService.MimeType.JSON);}
function configureFeed(){const ui=SpreadsheetApp.getUi(),r=ui.prompt('Automatischer Feed','HTTPS-Adresse eines JSON-Feeds gemäß Anleitung (kein DartConnect-Seitenlink)',ui.ButtonSet.OK_CANCEL);if(r.getSelectedButton()!==ui.Button.OK)return;const url=r.getResponseText().trim();if(!/^https:\/\//.test(url))throw Error('HTTPS-Adresse erforderlich.');PropertiesService.getScriptProperties().setProperty('FEED_URL',url);ui.alert('Feed gespeichert. Zuerst „Feed jetzt synchronisieren“ testen.');}
function syncFeedNow(){const p=PropertiesService.getScriptProperties(),url=p.getProperty('FEED_URL');if(!url)throw Error('Zuerst Feed einrichten.');const res=UrlFetchApp.fetch(url,{muteHttpExceptions:true});if(res.getResponseCode()!==200)throw Error('Feed HTTP '+res.getResponseCode());const data=JSON.parse(res.getContentText());if(!Array.isArray(data.events)||data.events.length>100)throw Error('Feed benötigt events-Array mit maximal 100 Einträgen.');p.deleteProperty('FEED_TEST_OK');for(const e of data.events)syncPayload_(e);if(!data.events.length)throw Error('Leerer Feed: noch kein erfolgreicher Test.');p.setProperty('FEED_TEST_OK',url);}
