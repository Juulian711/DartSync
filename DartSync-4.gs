// Formeln intern weiter in kanonischer Schreibweise erzeugen. Erst beim Schreiben lokalisieren.
function localizedFormula_(formula,locale){
  if(!/^(?:de|fr|nl|es|it|pt|da|no|nb|nn|sv|fi|pl|cs|sk|sl|hr|hu|ro|bg|ru|uk|el|tr|et|lv|lt|is)(?:[_-]|$)/i.test(locale))return formula;
  let out='',quoted=false,sheet=false;
  for(let i=0;i<formula.length;i++){const c=formula[i];
    if(c==='"'&&!sheet){if(quoted&&formula[i+1]==='"'){out+='""';i++;continue;}quoted=!quoted;}
    else if(c==="'"&&!quoted){if(sheet&&formula[i+1]==="'"){out+="''";i++;continue;}sheet=!sheet;}
    out+=(c===','&&!quoted&&!sheet)?';':c;
  }return out;
}
function writeFormula_(range,formula){const locale=range.getSheet().getParent().getSpreadsheetLocale();return range.setFormula(localizedFormula_(formula,locale));}
function writeFormulas_(range,formulas){const locale=range.getSheet().getParent().getSpreadsheetLocale();return range.setFormulas(formulas.map(row=>row.map(f=>localizedFormula_(f,locale))));}
function assertYearFormulas_(sheet,config){
  SpreadsheetApp.flush();
  const range=sheet.getRange(config.first,13,config.count,29),values=range.getDisplayValues(),formulas=range.getFormulas();
  for(let r=0;r<values.length;r++)for(let c=0;c<values[r].length;c++)if(formulas[r][c]&&/^#(?:ERROR!|REF!|DIV\/0!|NAME\?|VALUE!|N\/A|NUM!|NULL!|SPILL!|CALC!)/.test(values[r][c])){throw Error('Berechnungsfehler in '+sheet.getName()+'!'+range.getCell(r+1,c+1).getA1Notation()+': '+values[r][c]);}
}
function repairAllYearFormulas(){
  const lock=LockService.getScriptLock();lock.waitLock(30000);
  try{for(const sheet of ss_().getSheets()){if(!/^20\d{2}$/.test(sheet.getName()))continue;const y=Number(sheet.getName());let c;try{c=config_(y);}catch(e){continue;}installFormulas_(sheet,y,c.first,c.count);refreshSeason_(y);}
  SpreadsheetApp.getUi().alert('Alle eingerichteten Jahresformeln und Saisonübersichten wurden aktualisiert.');
  }finally{lock.releaseLock();}
}

function isHelperSheet_(name){
  return /^(?:Matches_|Spieler_|Turnier-Cockpit_)20\d{2}$/.test(name)||['Jahresvorlage','Spieler','Setup','Debug','Tipp-Protokoll'].includes(name);
}
function applyWorkbookView_(){
  for(const sheet of ss_().getSheets()){const name=sheet.getName();
    if(/^20\d{2}$/.test(name)){let c;try{c=config_(Number(name));}catch(e){continue;}sheet.setRowHeightsForced(c.first,c.count,DS.rowHeight);}
    if(name==='Jahresvorlage'){const values=sheet.getRange(DS.first,1,sheet.getLastRow()-DS.first+1,1).getValues();let count=0;for(const r of values){if(!Number.isInteger(r[0])||r[0]<1)break;count++;}if(count)sheet.setRowHeightsForced(DS.first,count,DS.rowHeight);}
    if(isHelperSheet_(name)&&!sheet.isSheetHidden())sheet.hideSheet();
  }
}
